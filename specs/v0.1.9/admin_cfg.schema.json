{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Admin Panel Configuration",
  "description": "Configuration file for theme, machines, favorites, and file type associations",
  "type": "object",
  "properties": {
    "theme": {
      "type": "string",
      "enum": ["light", "dark", "system"],
      "default": "system",
      "description": "UI theme preference"
    },
    "machines": {
      "type": "array",
      "description": "List of remote machines/VPS/containers to connect to",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Full URL including port and optional path (e.g. http://host:3000/app, https://app.railway.app)"
          },
          "name": {
            "type": "string",
            "description": "Display name for the machine (e.g., DevBox1, Chatbox-Railway)"
          },
          "apiSecret": {
            "type": "string",
            "description": "API secret key for authentication (e.g., sk-abcd123456)"
          }
        },
        "required": ["url", "name", "apiSecret"]
      },
      "default": [
        {
          "url": "http://localhost:3000",
          "name": "Local",
          "apiSecret": "api-secret"
        }
      ]
    },
    "favorites": {
      "type": "object",
      "description": "Favorites keyed by machine name, with _default for shared entries",
      "properties": {
        "_default": {
          "type": "array",
          "description": "Default favorites shared across all machines",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Absolute folder path"
              },
              "label": {
                "type": "string",
                "description": "Display name for the favorite"
              },
              "icon": {
                "type": "string",
                "description": "Material Design icon name"
              }
            },
            "required": ["path", "label", "icon"]
          }
        }
      },
      "additionalProperties": {
        "type": "array",
        "description": "Machine-specific favorites array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute folder path"
            },
            "label": {
              "type": "string",
              "description": "Display name for the favorite"
            },
            "icon": {
              "type": "string",
              "description": "Material Design icon name"
            }
          },
          "required": ["path", "label", "icon"]
        }
      },
      "default": {
        "_default": [
          {
            "path": "/",
            "label": "Home",
            "icon": "home"
          },
          {
            "path": "/home",
            "label": "Users",
            "icon": "folder_shared"
          }
        ]
      }
    },
    "fileTypes": {
      "type": "array",
      "description": "File extension to icon and color mappings",
      "items": {
        "type": "object",
        "properties": {
          "extension": {
            "type": "string",
            "pattern": "^\\.[a-zA-Z0-9]+$",
            "description": "File extension (e.g., .html, .py)"
          },
          "icon": {
            "type": "string",
            "enum": [
              "html",
              "css",
              "javascript",
              "code",
              "description",
              "image",
              "picture_as_pdf",
              "table_chart",
              "data_object",
              "terminal"
            ],
            "description": "Material Design icon name"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "Hex color code for the icon"
          }
        },
        "required": ["extension", "icon", "color"]
      },
      "default": [
        {
          "extension": "*",
          "icon": "description",
          "color": "#9ca3af"
        }
      ]
    },
    "upload_size_limit": {
      "type": "integer",
      "minimum": 1,
      "default": 1024,
      "description": "Maximum upload size in MB. Default 1024 (1 GB). Applies to both menu-button and drag-n-drop uploads."
    }
  },
  "required": ["theme", "machines", "favorites", "fileTypes"]
}
